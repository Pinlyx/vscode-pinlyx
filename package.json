{
  "name": "pinlyx",
  "displayName": "Pinlyx",
  "description": "Adds the Pinlyx MCP server to VS Code in one step: your omnichannel inbox, contacts, deals and tasks inside your AI assistant.",
  "version": "0.1.0",
  "publisher": "pinlyx",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://pinlyx.com/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pinlyx/vscode-pinlyx.git"
  },
  "bugs": {
    "url": "https://github.com/Pinlyx/vscode-pinlyx/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "crm",
    "mcp",
    "inbox",
    "telegram",
    "whatsapp",
    "pinlyx"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "pinlyx.mcp",
        "label": "Pinlyx"
      }
    ],
    "commands": [
      {
        "command": "pinlyx.openDashboard",
        "title": "Open dashboard",
        "category": "Pinlyx"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
